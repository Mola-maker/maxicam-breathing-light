def rgb(r, g, b):
    return image.Color.from_rgb(int(r), int(g), int(b))


def mix(a, b, t):
    t = 0.0 if t < 0.0 else 1.0 if t > 1.0 else t
    return rgb(a[0] + (b[0] - a[0]) * t,
               a[1] + (b[1] - a[1]) * t,
               a[2] + (b[2] - a[2]) * t)


def clamp(x, lo, hi):
    return lo if x < lo else hi if x > hi else x


