#!/usr/bin/env python3
"""
MaixCAM Pro 语音门控 18 kHz PWM 灯控

业务:
    语音门改成"单字/整词识别 + 时序拼装"两段:
        1. 识别段注册八个单字关键词:
           chang1/chang2/chang4, chun1/chun2/chun3, ang1/ang2。
           (模型词表没有 chun4, 实测会报 parse kws error; chun3 可用)
           另外注册一个整词关键词 "chang2 chun1"（Maix-Speech 支持空格分隔的
           多音节拼音）。连续说"长春"时单字 KWS 经常只上报其中一个字，整词
           KWS 可以直接给出高概率；拖长"长～～春"仍走单字拼装。
        2. 判断段:
           - 整词 phrase 概率 >= 0.30: 直接开门；
           - 否则按单字序列: chang 后出现 chun，拼装分取两字置信度的 max；
           - 拖长“长～～春”时如果只报 chun：本次连续人声（RMS >= 0.03）
             在 chun 前已持续 >= 0.80s，则把长前导当作拖长的“长”；
             此时 chun 只需 >= 0.10（拖长会使 chun 概率明显下降）即开门；
             单独短促的“春”不满足“连续人声 >= 0.80s”；
           - 只出现 ang、顺序不对、超时或置信度不足时保持关灯。
    门控后从当前 PWM 亮度经 0.03 秒贝塞尔曲线直接升到 100%;
    之后保持 100%, 直到 env_fast < 本次最大声强的 15% 且持续 0.05 秒;
    拖音 "un-----" 期间只由声强包络保持: env_fast >= 本次峰值的 15% 时继续 100%;
    释放后再走 2.5 秒斜坡:
        100% -> 50% 0.5 秒, 50% -> 35% 0.8 秒 (三次贝塞尔, 先快后慢);
        35% -> STANDBY_MAX(8%) 1.2 秒线性;
        到 8% 后从呼吸最大值进入待机呼吸, 不再跳变。

关键点:
    实测 nn.Speech.run() 会持续持有 Python GIL, 同进程的 Python 线程无法
    在推理期间得到调度。因此逻辑上仍分成"识别"和"判断"两段, 但为了真正
    用满两个核, 判断段放在独立子进程; 识别到单字后通过 Pipe 实时送出。
    PWM 控制和音量 DSP 继续放在独立进程里, 保证 100 Hz 的 PWM 更新不被阻塞。

硬件:
    A18 -> PWM6 -> /sys/class/pwm/pwmchip4/pwm2
    A19 -> PWM7 -> /sys/class/pwm/pwmchip4/pwm3
    载波 18 kHz, duty 0~100%。
    注意: A18/A19 是 3.3V 逻辑 PWM, 必须经过 MOSFET/驱动级,
    不得直接接灯珠或大电流负载。

环境变量:
    VOICE_AM_MODEL        KWS 声学模型, 默认 /root/models/am_3332_192_int8.mud
    VOICE_GATE_THRESHOLD  单字两字阈值的门限, 默认 0.35
    VOICE_PHRASE_THRESHOLD 整词 chang2 chun1 的门限, 默认 0.30
    VOICE_CHAR_THRESHOLD  单字送入判断段的概率门限, 默认 0.10
    VOICE_CHAR_DEBOUNCE   同一字族重复上报的最小间隔, 默认 0.18 秒
    VOICE_PHRASE_DEBOUNCE 整词重复上报的最小间隔, 默认 2.0 秒
    VOICE_SEQ_WINDOW      chang 到 chun 的可选最大间隔, 默认 0 (不限时);
                          正数表示超过该秒数后丢弃旧 chang
    VOICE_LONG_PREFIX_SECONDS 只报 chun 时，判为拖长“长”前导的最小连续
                          人声时长, 默认 0.80 秒
    VOICE_LONG_PREFIX_RMS 累计“长前导”所用的 RMS 门限, 默认 0.030
    VOICE_LONG_PREFIX_MIN_CONF 长前导成立时 chun 的最低置信度, 默认 0.10;
                          拖得越长 KWS 的 chun 概率会下降，因此这里低于 0.35

    VOICE_GATE_COOLDOWN   开门后抑制重复序列的冷却时间, 默认 1.0 秒
    VOICE_ALSA_DEVICE     默认 surplife_mic (见 /root/.asoundrc)
    VOICE_INPUT_WAV       可选: 指定 WAV 文件用于离线调试 (DEVICE_WAV)
    VOICE_TAP_FIFO        默认 /root/surplife/run/surplife_mic.pcm

    PWM_FREQ              载波频率, 默认 18000
    PWM_UPDATE_HZ         PWM 更新率, 默认 100
    PWM6_PATH / PWM7_PATH sysfs 通道路径
    PWM7_MODE             freq | mirror | square | off, 默认 freq
    A18_BLINK             1 = A18 也按闪烁频率做亮灭翻转, 默认 0
    BLINK_HZ_MIN/MAX      闪烁频率范围, 默认 1 / 8 Hz
    BLINK_INVERT          1 = 声量越大闪得越慢
    STANDBY_MIN/MAX       待机呼吸占空比, 默认 1 / 8 %
    STANDBY_PERIOD        待机呼吸周期, 默认 4 秒
    BUSINESS_MIN/MAX      业务映射范围 (实机斜坡从 MAX 到阈值), 默认 40 / 100 %
    BUSINESS_INTRO_SECONDS 门控后当前亮度->INTRO_TARGET 的贝塞尔上升时长, 默认 0.03 秒
    BUSINESS_INTRO_TARGET 门控上升目标亮度, 默认 100 %
    BUSINESS_BEZIER_SECONDS 100%->35% 贝塞尔段时长, 默认 1.3 秒 (100->50: 0.5s, 50->35: 0.8s)
    BUSINESS_LINEAR_SECONDS 35%->STANDBY_MAX 线性段时长, 默认 1.2 秒
    BUSINESS_HOLD_RATIO  拖音保持释放阈值 (×本次峰值), 默认 0.15
    BUSINESS_HOLD_RELEASE_SECONDS 低于阈值持续多久后释放, 默认 0.05 秒
    LIGHT_THRESHOLD       业务斜坡终点/回待机阈值, 默认 35 %
    DECAY_TICK_MS         演示模式“每 tick”时长, 默认 20 ms
    WORK_DECAY_PER_TICK   仅 PWM_DEMO 使用, 默认 1
    RELEASE_DECAY_PER_TICK 仅 PWM_DEMO 使用, 默认 3
    VOICE_ACTIVE_MIN      判为人声的最小线性 RMS, 默认 0.01
    VOICE_ACTIVE_RATIO    判为人声的相对门限, 默认 0.04 * ref
    MIN_REF               最小人声参考 (线性 RMS), 默认 0.002
    PWM_DRY_RUN           1 = 只计算不写 PWM
    PWM_DEMO              1 = 不依赖语音, 自动演示 2s 待机 + 5s 业务 + 衰减
    SURPLIFE_LOG          日志级别, 默认 INFO
    VOICE_NICE            语音进程 nice 值, 默认 -10 (需要 root)
    VOICE_OOM_SCORE_ADJ   语音进程 OOM 分数, 默认 -800 (越低越不容易被杀)
"""

from __future__ import annotations

import collections
import errno
import logging
import math
import multiprocessing as mp
import os
import signal
import sys
import time

log = logging.getLogger("voice_pwm")


def _env_int(name: str, default: int) -> int:
    try:
        return int(os.environ.get(name, default))
    except (TypeError, ValueError):
        return default


def raise_voice_priority() -> None:
    """提高语音进程调度优先级，并降低被 OOM killer 选中的概率。

    生产 voice_pwm 和 UI 的 live_kws 子进程都会调用；fork 出来的 DSP/PWM
    子进程会继承 nice 和 oom_score_adj。
    """
    target_nice = _env_int("VOICE_NICE", -10)
    current_nice = None
    try:
        current_nice = os.nice(0)
        if current_nice > target_nice:
            os.nice(target_nice - current_nice)
            current_nice = target_nice
    except OSError as exc:
        log.warning("设置 nice=%d 失败: %s", target_nice, exc)

    target_oom = _env_int("VOICE_OOM_SCORE_ADJ", -800)
    actual_oom = None
    try:
        with open("/proc/self/oom_score_adj", "w", encoding="ascii") as f:
            f.write(str(target_oom))
        with open("/proc/self/oom_score_adj", "r", encoding="ascii") as f:
            actual_oom = int(f.read().strip())
    except (OSError, ValueError) as exc:
        log.warning("设置 oom_score_adj=%d 失败: %s", target_oom, exc)

    log.info("voice priority: nice=%s oom_score_adj=%s", current_nice, actual_oom)


# ======================================================================
# 纯逻辑 (可在没有硬件的机器上测试)
# ======================================================================

def clamp(x: float, lo: float, hi: float) -> float:
    return lo if x < lo else hi if x > hi else x


def breathing_duty(t: float, period: float = 4.0,
                   lo: float = 1.0, hi: float = 8.0) -> float:
    """待机慢速呼吸: 从 lo 开始, 在 lo~hi 之间正弦变化。"""
    phase = 2.0 * math.pi * t / max(period, 0.1) - math.pi / 2.0
    return lo + (hi - lo) * (0.5 + 0.5 * math.sin(phase))


def cubic_bezier_progress(x: float, x1: float, y1: float,
                          x2: float, y2: float) -> float:
    """三次贝塞尔缓动: 输入归一化时间 x, 返回归一化进度。"""
    x = clamp(x, 0.0, 1.0)
    lo, hi = 0.0, 1.0
    for _ in range(24):
        s = (lo + hi) * 0.5
        u = 1.0 - s
        xs = 3.0 * u * u * s * x1 + 3.0 * u * s * s * x2 + s ** 3
        if xs < x:
            lo = s
        else:
            hi = s
    s = (lo + hi) * 0.5
    u = 1.0 - s
    return 3.0 * u * u * s * y1 + 3.0 * u * s * s * y2 + s ** 3


BUSINESS_BEZIER_SPLIT = 0.5 / 1.3


def business_ramp_progress(x: float) -> float:
    """
    业务 100% -> 35% 的三次贝塞尔进度 (先快后慢)。

    归一化时间 x=0.5/1.3 时进度 = (100-50)/(100-35) = 50/65,
    即默认 1.3 秒段里 0.5 秒到 50%, 剩余 0.8 秒到 35%。
    控制点 (0.25, 1.0), (0.791567..., 1.0) 是按这个约束选的。
    """
    return cubic_bezier_progress(x, 0.25, 1.0, 0.791567089396, 1.0)


def intro_ramp_progress(x: float) -> float:
    """门控上升段: 标准缓入缓出三次贝塞尔。"""
    return cubic_bezier_progress(x, 0.42, 0.0, 0.58, 1.0)


def business_brightness(level: float, lo: float = 40.0, hi: float = 100.0) -> float:
    """业务亮度: level 0 -> lo, level 1 -> hi, 默认始终高于 35%。"""
    return lo + (hi - lo) * clamp(level, 0.0, 1.0)


def top_fraction_mean(values, fraction: float = 0.30) -> float:
    """取前 fraction 比例的均值; 用于拖音稳健声强 E_d。"""
    vals = sorted(values, reverse=True)
    if not vals:
        return 0.0
    k = max(1, int(len(vals) * fraction))
    return sum(vals[:k]) / k


# 影子测量标签: 只记录 E_k/E_d, 不注册第二路 KWS, 也不参与亮度决策。
UN_EXPERIMENT_CANDIDATE = "en1"


def blink_hz(level: float, lo: float = 1.0, hi: float = 8.0) -> float:
    """声量越大 -> 闪烁频率越高 (默认)。"""
    return lo + (hi - lo) * clamp(level, 0.0, 1.0)


def decay_step(light: float, target: float, decay_per_tick: float,
               dt: float, tick_seconds: float) -> float:
    """
    非对称包络的单步:

        light -= decay_per_tick * (dt / tick_seconds)
        if target > light:
            light = target

    声音变大时 target 直接覆盖当前亮度(快攻); 声音变小时
    亮度按 decay_per_tick 慢慢下降(慢放)。返回 0~100。
    """
    tick_seconds = max(0.001, tick_seconds)
    decayed = light - max(0.0, decay_per_tick) * (max(0.0, dt) / tick_seconds)
    if target > decayed:
        decayed = target
    return clamp(decayed, 0.0, 100.0)


# ======================================================================
# 单字关键词与时序拼装
# ======================================================================

# 只注册单字。KWS 的 True 参数允许近音, 所以声调仍可能互相抢概率;
# 判断段按字族(chang/ang/chun)拼装, 不依赖具体声调是否完全正确。
#
# 注意: am_3332_192_int8 的词表里没有 "chun4" (实测
# "parse kws chun4 error!"), 但支持 "chun3"; 因此用 chun3 代替
# 用户列出的 chun4, 仍然保持 8 个关键词。
CHAR_KEYWORD_SPECS = (
    ("chang1", "chang"),
    ("chang2", "chang"),
    ("chang4", "chang"),
    ("chun1", "chun"),
    ("chun2", "chun"),
    ("chun3", "chun"),
    ("ang1", "ang"),
    ("ang2", "ang"),
)
UNSUPPORTED_CHAR_KEYWORDS = ("chun4",)
CHAR_KEYWORDS = tuple(keyword for keyword, _family in CHAR_KEYWORD_SPECS)
CHAR_FAMILY_OF = dict(CHAR_KEYWORD_SPECS)
CHAR_FAMILY_ORDER = ("chang", "ang", "chun")

# 额外注册一个正常连读的整词关键词。Maix-Speech 的 kws 支持用空格分隔的
# 多音节拼音（例如 "xiao3 ai4 tong2 xue2"）；连续说“长春”时单字 KWS 有时
# 只上报其中一个字，但整词 KWS 能直接给出“chang2 chun1”的概率。
# 拖长“长～～春”仍然走下面的单字拼装路径。
PHRASE_KEYWORD_SPECS = (
    ("chang2 chun1", "phrase"),
)
PHRASE_KEYWORDS = tuple(keyword for keyword, _family in PHRASE_KEYWORD_SPECS)
KWS_KEYWORDS = CHAR_KEYWORDS + PHRASE_KEYWORDS
KWS_FAMILY_OF = dict(CHAR_FAMILY_OF)
KWS_FAMILY_OF.update(dict(PHRASE_KEYWORD_SPECS))
KWS_FAMILY_ORDER = CHAR_FAMILY_ORDER + ("phrase",)

# 判断进程收到的事件: 时间戳、墙钟、关键词、字族、置信度、本次连续人声时长。
# pre_voiced 由 DSP 子进程依据 RMS 实时累计，供“拖长的长”兜底判断。
CharEvent = collections.namedtuple(
    "CharEvent", "mono wall keyword family conf pre_voiced",
    defaults=(0.0,))


# ======================================================================
# 音量 DSP (在子进程里运行, 避免被 nn.Speech 的 GIL 阻塞)
# ======================================================================

# 实机只运行轻量 RMS 包络 (_tap_reader_simple)。旧 FFT/谱减增强器已移除:
# KWS 推理本身占用大量 CPU/GIL, 再跑 FFT 会和识别抢资源, 拖音包络反而变差。

class MicTap:
    """管理音量 DSP 子进程; 必须在 nn.Speech 打开 surplife_mic 之前启动。"""

    def __init__(self, fifo: str, stop_event, voice_min: float = 0.01):
        self.fifo = fifo
        ctx = mp.get_context("fork")
        self.env_fast = ctx.Value("d", 0.0, lock=False)
        self.env_slow = ctx.Value("d", 0.0, lock=False)
        self.peak_rms = ctx.Value("d", 0.0, lock=False)
        self.peak_080 = ctx.Value("d", 0.0, lock=False)
        self.noise_db = ctx.Value("d", -60.0, lock=False)
        self.wind = ctx.Value("d", 0.0, lock=False)
        self.kws_prob = ctx.Value("d", 0.0, lock=False)
        self.business = ctx.Value("d", 0.0, lock=False)
        # 当前连续人声已经持续多久；静音 0.6s 后清零。
        self.voice_duration = ctx.Value("d", 0.0, lock=False)

        parent = os.path.dirname(fifo)
        if parent:
            os.makedirs(parent, exist_ok=True)
        if os.path.exists(fifo):
            os.remove(fifo)
        os.mkfifo(fifo, 0o600)
        self.proc = ctx.Process(
            target=_tap_reader_simple,
            args=(fifo, stop_event, self.env_fast, self.env_slow,
                  self.peak_rms, self.peak_080, self.noise_db, self.wind,
                  self.kws_prob, self.business, self.voice_duration, voice_min),
            daemon=True,
        )
        self.proc.start()

    def close(self) -> None:
        if self.proc.is_alive():
            self.proc.terminate()
            self.proc.join(1)
        if os.path.exists(self.fifo):
            try:
                os.remove(self.fifo)
            except OSError:
                pass


# ======================================================================
# PWM 子进程 (sysfs, 不依赖 maix, 避免下次 fork 破坏多媒体状态)
# ======================================================================

class SysfsPwm:
    """直接写 Linux PWM sysfs, 周期单位 ns。"""

    def __init__(self, path: str, period_ns: int, dry_run: bool = False):
        self.path = path
        self.period_ns = period_ns
        self.dry_run = dry_run
        if not dry_run:
            self._ensure_export()
            # 刚 export 的通道 period=0 时，部分内核会拒绝 enable=0
            # 并返回 EINVAL；这表示通道本来就是关闭的，继续配置即可。
            try:
                self._write("enable", 0)
            except OSError as exc:
                if exc.errno != errno.EINVAL:
                    raise
            self._write("period", self.period_ns)
            self._write("duty_cycle", 0)
            self._write("enable", 1)

    def _ensure_export(self) -> None:
        if os.path.isdir(self.path):
            return
        chip = os.path.dirname(self.path)
        channel = os.path.basename(self.path).replace("pwm", "")
        try:
            with open(os.path.join(chip, "export"), "w") as f:
                f.write(str(channel))
        except OSError as exc:
            if exc.errno != errno.EBUSY:
                raise
        for _ in range(50):
            if os.path.isdir(self.path):
                return
            time.sleep(0.01)
        raise RuntimeError(f"PWM export failed: {self.path}")

    def _write(self, name: str, value: int) -> None:
        with open(os.path.join(self.path, name), "w") as f:
            f.write(str(value))

    def set_duty(self, percent: float) -> None:
        if self.dry_run:
            return
        percent = clamp(percent, 0.0, 100.0)
        duty_ns = int(round(self.period_ns * percent / 100.0))
        self._write("duty_cycle", duty_ns)

    def disable(self) -> None:
        if self.dry_run:
            return
        try:
            self._write("duty_cycle", 0)
            self._write("enable", 0)
        except OSError:
            pass


def _clog(msg: str) -> None:
    try:
        os.write(1, f"[pwm {time.strftime('%H:%M:%S')}] {msg}\n".encode())
    except OSError:
        pass


def _pwm_worker(stop_event, ready_event, gate_seq, env_fast, env_slow, peak_rms,
                peak_080, business, cfg) -> None:
    signal.signal(signal.SIGINT, signal.SIG_IGN)

    # 这个进程在导入 maix 之前 fork, 只等父进程把 A18/A19 复用成 PWM6/PWM7。
    if not ready_event.wait(10.0):
        _clog("pinmap ready timeout")
        os._exit(2)
    if stop_event.is_set():
        os._exit(0)

    try:
        pwm6 = SysfsPwm(cfg["pwm6_path"], cfg["period_ns"], cfg["dry_run"])
    except Exception as exc:  # noqa: BLE001
        _clog(f"A18/PWM6 init failed: {exc}")
        os._exit(2)

    # A19/PWM7 是闪烁/频率给定辅助通道；它失败不应影响 A18 待机呼吸。
    pwm7 = None
    try:
        pwm7 = SysfsPwm(cfg["pwm7_path"], cfg["period_ns"], cfg["dry_run"])
    except Exception as exc:  # noqa: BLE001
        _clog(f"A19/PWM7 init failed, continue with A18 only: {exc}")

    state = "standby"
    ref = cfg["min_ref"]
    light_level = 0.0
    business_start = 0.0
    hold_active = False
    hold_peak = cfg["min_ref"]
    hold_low_since = 0.0
    intro_active = False
    intro_start = 0.0
    intro_from = 0.0
    intro_target = cfg["business_intro_target"]
    last_bright = 0.0
    un_ek = 0.0
    un_envs = collections.deque(maxlen=500)
    un_start = 0.0
    last_gate_seq = gate_seq.value
    linear_logged = False
    blink_phase = 0.0
    start = time.monotonic()
    breath_start = start
    last_tick = start
    last_log = 0.0

    _clog("start, standby breathing on A18/PWM6%s mode=%s" % (
        ", A19/PWM7" if pwm7 is not None else " (A19 unavailable)", cfg["pwm7_mode"]))

    try:
        while not stop_event.is_set() and os.getppid() != 1:
            now = time.monotonic()
            dt = clamp(now - last_tick, 0.001, 0.10)
            last_tick = now
            level = 0.0
            level_slow = 0.0
            bright = 0.0
            hz = cfg["blink_hz_min"]
            voice_active = False

            if cfg["demo"]:
                t = now - start
                tick_s = cfg["decay_tick_ms"] / 1000.0
                if 2.0 <= t < 7.0:
                    state = "business"
                    business.value = 1.0
                    voice_active = True
                    level = 0.5 + 0.5 * math.sin(2.0 * math.pi * 0.25 * (t - 2.0))
                    level_slow = level
                    ref = 1.0
                    target = business_brightness(
                        level, cfg["business_min"], cfg["business_max"])
                    light_level = decay_step(
                        light_level, target, cfg["work_decay"], dt, tick_s)
                    bright = light_level
                    hz = blink_hz(level_slow, cfg["blink_hz_min"], cfg["blink_hz_max"])
                    if cfg["blink_invert"]:
                        hz = cfg["blink_hz_min"] + cfg["blink_hz_max"] - hz
                elif 7.0 <= t and state == "business":
                    business.value = 1.0
                    voice_active = False
                    level = 0.0
                    level_slow = 0.0
                    light_level = decay_step(
                        light_level, 0.0, cfg["release_decay"], dt, tick_s)
                    bright = light_level
                    hz = blink_hz(0.0, cfg["blink_hz_min"], cfg["blink_hz_max"])
                    if light_level < cfg["light_threshold"]:
                        state = "standby"
                        business.value = 0.0
                        light_level = 0.0
                        bright = breathing_duty(t, cfg["standby_period"],
                                                cfg["standby_min"], cfg["standby_max"])
                else:
                    if state == "business":
                        business.value = 0.0
                    state = "standby"
                    light_level = 0.0
                    bright = breathing_duty(t, cfg["standby_period"],
                                            cfg["standby_min"], cfg["standby_max"])
            else:
                if gate_seq.value != last_gate_seq:
                    last_gate_seq = gate_seq.value
                    state = "business"
                    business_start = now
                    linear_logged = False
                    hold_peak = ref = max(
                        peak_rms.value, env_fast.value, cfg["min_ref"])
                    hold_low_since = 0.0
                    un_ek = peak_080.value
                    un_envs.clear()
                    un_start = now
                    blink_phase = 0.0
                    business.value = 1.0
                    top = cfg["business_max"]
                    intro_start = now
                    intro_from = clamp(last_bright, 0.0, top)
                    intro_target = clamp(cfg["business_intro_target"],
                                         0.0, top)
                    intro_s = cfg["business_intro_seconds"]
                    if intro_from < intro_target and intro_s > 0.0:
                        intro_active = True
                        hold_active = False
                        light_level = intro_from
                        intro_log = (f"fade {intro_from:.0f}%->"
                                     f"{intro_target:.0f}% "
                                     f"{intro_s:.2f}s bezier")
                        if intro_target < top:
                            intro_log += f", jump {top:.0f}%"
                    else:
                        intro_active = False
                        hold_active = True
                        light_level = top
                        intro_log = f"jump {top:.0f}%"
                    _clog(f"GATE -> business, {intro_log}, hold 100% until "
                          f"env < {cfg['business_hold_ratio']*100:.0f}% peak "
                          f"for {cfg['business_hold_release_seconds']:.2f}s; "
                          f"then {top:.0f}% -> "
                          f"{cfg['light_threshold']:.0f}% in "
                          f"{cfg['business_bezier_seconds']:.2f}s bezier + "
                          f"{cfg['standby_max']:.0f}% in "
                          f"{cfg['business_linear_seconds']:.1f}s linear "
                          f"(ref={ref:.4f})")

                if state == "standby":
                    bright = breathing_duty(now - breath_start,
                                            cfg["standby_period"],
                                            cfg["standby_min"], cfg["standby_max"])
                else:
                    env = env_fast.value
                    voice_floor = max(cfg["voice_active_min"],
                                      cfg["voice_active_ratio"] * ref)
                    voice_active = env >= voice_floor
                    if intro_active or hold_active:
                        un_envs.append(env)

                    top = cfg["business_max"]
                    mid = cfg["light_threshold"]
                    end = cfg["standby_max"]
                    bezier_s = cfg["business_bezier_seconds"]
                    linear_s = cfg["business_linear_seconds"]

                    if intro_active:
                        hold_peak = max(hold_peak, env)
                        elapsed_intro = now - intro_start
                        if elapsed_intro < cfg["business_intro_seconds"]:
                            x = elapsed_intro / max(
                                cfg["business_intro_seconds"], 1e-6)
                            light_level = intro_from + (
                                intro_target - intro_from
                            ) * intro_ramp_progress(x)
                        else:
                            intro_active = False
                            hold_active = True
                            hold_low_since = 0.0
                            light_level = top
                            suffix = (f", jump {top:.0f}%"
                                      if intro_target < top else "")
                            _clog(f"INTRO done{suffix} "
                                  f"(from {intro_from:.0f}%, "
                                  f"target {intro_target:.0f}%)")
                    else:
                        if hold_active:
                            hold_peak = max(hold_peak, env)
                            hold_floor = max(cfg["voice_active_min"],
                                             cfg["business_hold_ratio"] * hold_peak)
                            if env < hold_floor:
                                if hold_low_since <= 0.0:
                                    hold_low_since = now
                                elif (now - hold_low_since
                                      >= cfg["business_hold_release_seconds"]):
                                    hold_active = False
                                    hold_low_since = 0.0
                                    business_start = now
                                    linear_logged = False
                                    ed = top_fraction_mean(un_envs, 0.30)
                                    ratio = ed / un_ek if un_ek > 1e-9 else 0.0
                                    _clog(f"HOLD release, env={env:.4f} < "
                                          f"{hold_floor:.4f} "
                                          f"(peak={hold_peak:.4f}), start "
                                          f"{top:.0f}%->{end:.0f}% "
                                          f"{bezier_s + linear_s:.1f}s")
                                    _clog(f"UNMEASURE cand="
                                          f"{UN_EXPERIMENT_CANDIDATE} "
                                          f"ek={un_ek:.4f} ed={ed:.4f} "
                                          f"ratio={ratio:.3f} "
                                          f"dur={now - un_start:.2f}s "
                                          f"frames={len(un_envs)}")
                                    un_envs.clear()
                            else:
                                hold_low_since = 0.0

                        if hold_active:
                            light_level = top
                        else:
                            elapsed_business = max(0.0, now - business_start)
                            if elapsed_business < bezier_s:
                                x = elapsed_business / bezier_s
                                light_level = top - (top - mid) * business_ramp_progress(x)
                            elif elapsed_business < bezier_s + linear_s:
                                if not linear_logged:
                                    linear_logged = True
                                    _clog(f"business {mid:.0f}% -> {end:.0f}% "
                                          f"linear {linear_s:.1f}s")
                                x = (elapsed_business - bezier_s) / linear_s
                                light_level = mid - (mid - end) * clamp(x, 0.0, 1.0)
                            else:
                                _clog(f"EXIT -> standby, handoff={end:.0f}% "
                                      f"elapsed={elapsed_business:.2f}s "
                                      f"env={env:.4f} ref={ref:.4f} "
                                      f"voice_active={int(voice_active)}")
                                state = "standby"
                                hold_active = False
                                intro_active = False
                                hold_low_since = 0.0
                                business.value = 0.0
                                ref = cfg["min_ref"]
                                light_level = 0.0
                                # 呼吸在 8% 峰值处接上: 相位 pi/2 对应 hi。
                                breath_start = now - cfg["standby_period"] / 2.0
                                bright = breathing_duty(
                                    now - breath_start, cfg["standby_period"],
                                    cfg["standby_min"], cfg["standby_max"])

                    if state == "business":
                        bright = light_level
                        span = max(1.0, top - end)
                        level_slow = clamp((light_level - end) / span, 0.0, 1.0)
                        level = level_slow
                        hz = blink_hz(level_slow, cfg["blink_hz_min"],
                                      cfg["blink_hz_max"])
                        if cfg["blink_invert"]:
                            hz = (cfg["blink_hz_min"] + cfg["blink_hz_max"]
                                  - hz)

            # 闪烁相位
            blink_phase += hz * dt
            if blink_phase >= 1.0:
                blink_phase -= math.floor(blink_phase)
            blink_on = blink_phase < 0.5
            in_business = (state == "business")

            duty6 = bright
            if in_business and cfg["a18_blink"] and not blink_on:
                duty6 = 0.0

            mode = cfg["pwm7_mode"]
            if not in_business:
                duty7 = duty6 if mode == "mirror" else 0.0
            elif mode == "mirror":
                duty7 = bright if (not cfg["a18_blink"] or blink_on) else 0.0
            elif mode == "freq":
                duty7 = level_slow * 100.0
            elif mode == "square":
                duty7 = 100.0 if blink_on else 0.0
            else:  # off
                duty7 = 0.0

            pwm6.set_duty(duty6)
            last_bright = bright
            if pwm7 is not None:
                pwm7.set_duty(duty7)

            if now - last_log >= 1.0:
                last_log = now
                if in_business:
                    _clog(f"business level={level:.2f}/{level_slow:.2f} "
                          f"env={env_fast.value:.4f} light={light_level:.0f}% "
                          f"hold={int(hold_active)} intro={int(intro_active)} "
                          f"voice={int(voice_active)} "
                          f"bright={duty6:.0f}% hz={hz:.1f} A19={duty7:.0f}%")
                else:
                    _clog(f"standby breath={duty6:.1f}% raw_env={env_fast.value:.4f}")

            elapsed = time.monotonic() - now
            time.sleep(max(0.0, 1.0 / cfg["update_hz"] - elapsed))
    finally:
        try:
            pwm6.set_duty(0)
            pwm6.disable()
        except Exception:  # noqa: BLE001
            pass
        if pwm7 is not None:
            try:
                pwm7.set_duty(0)
                pwm7.disable()
            except Exception:  # noqa: BLE001
                pass
        _clog("stopped, PWM off")
        os._exit(0)


def _pwm_off(path: str) -> None:
    """父进程兜底关闭 PWM, 防止子进程被 SIGKILL 后灯常亮。"""
    for name, value in (("duty_cycle", 0), ("enable", 0)):
        try:
            with open(os.path.join(path, name), "w") as f:
                f.write(str(value))
        except OSError:
            pass


# ======================================================================
# 配置与主进程
# ======================================================================

def _env_float(name: str, default: float) -> float:
    try:
        return float(os.environ.get(name, default))
    except ValueError:
        return default


def _env_int(name: str, default: int) -> int:
    try:
        return int(float(os.environ.get(name, default)))
    except ValueError:
        return default


def _env_bool(name: str, default: bool = False) -> bool:
    value = os.environ.get(name)
    if value is None:
        return default
    return value.strip().lower() in ("1", "true", "yes", "on")


def build_config() -> dict:
    freq = max(1, _env_int("PWM_FREQ", 18000))
    mode = os.environ.get("PWM7_MODE", "freq").strip().lower()
    if mode not in ("freq", "mirror", "square", "off"):
        mode = "freq"
    gate_threshold = clamp(
        _env_float("VOICE_GATE_THRESHOLD", 0.35), 0.0, 1.0)
    phrase_threshold = clamp(
        _env_float("VOICE_PHRASE_THRESHOLD", 0.30), 0.0, 1.0)
    char_threshold = clamp(
        _env_float("VOICE_CHAR_THRESHOLD", 0.10), 0.0, 1.0)
    char_debounce = clamp(
        _env_float("VOICE_CHAR_DEBOUNCE", 0.18), 0.0, 5.0)
    phrase_debounce = clamp(
        _env_float("VOICE_PHRASE_DEBOUNCE", 2.0), 0.0, 10.0)
    seq_window = clamp(
        _env_float("VOICE_SEQ_WINDOW", 0.0), 0.0, 3600.0)
    gate_cooldown = clamp(
        _env_float("VOICE_GATE_COOLDOWN", 1.0), 0.0, 10.0)
    long_prefix_seconds = clamp(
        _env_float("VOICE_LONG_PREFIX_SECONDS", 0.80), 0.0, 10.0)
    long_prefix_rms = clamp(
        _env_float("VOICE_LONG_PREFIX_RMS", 0.030), 0.0, 1.0)
    long_prefix_min_conf = clamp(
        _env_float("VOICE_LONG_PREFIX_MIN_CONF", 0.10), 0.0, 1.0)

    light_threshold = clamp(_env_float("LIGHT_THRESHOLD", 35.0), 0.0, 99.0)
    business_min = max(_env_float("BUSINESS_MIN", 40.0), light_threshold + 1.0)
    business_max = clamp(_env_float("BUSINESS_MAX", 100.0), business_min, 100.0)

    return {
        "model": os.environ.get("VOICE_AM_MODEL", "/root/models/am_3332_192_int8.mud"),
        "kws_keywords": KWS_KEYWORDS,
        "char_keywords": CHAR_KEYWORDS,
        "phrase_keywords": PHRASE_KEYWORDS,
        "char_threshold": char_threshold,
        "char_debounce": char_debounce,
        "phrase_debounce": phrase_debounce,
        "gate_threshold": gate_threshold,
        "phrase_threshold": phrase_threshold,
        "seq_window": seq_window,
        "gate_cooldown": gate_cooldown,
        "long_prefix_seconds": long_prefix_seconds,
        "long_prefix_rms": long_prefix_rms,
        "long_prefix_min_conf": long_prefix_min_conf,
        "alsa_device": os.environ.get("VOICE_ALSA_DEVICE", "surplife_mic"),
        "input_wav": os.environ.get("VOICE_INPUT_WAV", "").strip(),
        "fifo": os.environ.get("VOICE_TAP_FIFO", "/root/surplife/run/surplife_mic.pcm"),
        "pwm6_path": os.environ.get("PWM6_PATH", "/sys/class/pwm/pwmchip4/pwm2"),
        "pwm7_path": os.environ.get("PWM7_PATH", "/sys/class/pwm/pwmchip4/pwm3"),
        "period_ns": int(1_000_000_000 / freq),
        "update_hz": clamp(_env_int("PWM_UPDATE_HZ", 100), 20, 200),
        "pwm7_mode": mode,
        "a18_blink": _env_bool("A18_BLINK", False),
        "blink_hz_min": _env_float("BLINK_HZ_MIN", 1.0),
        "blink_hz_max": _env_float("BLINK_HZ_MAX", 8.0),
        "blink_invert": _env_bool("BLINK_INVERT", False),
        "standby_min": _env_float("STANDBY_MIN", 1.0),
        "standby_max": _env_float("STANDBY_MAX", 8.0),
        "standby_period": _env_float("STANDBY_PERIOD", 4.0),
        "business_min": business_min,
        "business_max": business_max,
        "business_intro_seconds": clamp(
            _env_float("BUSINESS_INTRO_SECONDS", 0.03), 0.0, 10.0),
        "business_intro_target": clamp(
            _env_float("BUSINESS_INTRO_TARGET", 100.0), 0.0, 100.0),
        "business_bezier_seconds": clamp(
            _env_float("BUSINESS_BEZIER_SECONDS", 1.3), 0.05, 60.0),
        "business_linear_seconds": clamp(
            _env_float("BUSINESS_LINEAR_SECONDS", 1.2), 0.05, 60.0),
        "business_hold_ratio": clamp(
            _env_float("BUSINESS_HOLD_RATIO", 0.15), 0.01, 0.95),
        "business_hold_release_seconds": clamp(
            _env_float("BUSINESS_HOLD_RELEASE_SECONDS", 0.05), 0.0, 10.0),
        "light_threshold": light_threshold,
        "decay_tick_ms": clamp(_env_float("DECAY_TICK_MS", 20.0), 1.0, 1000.0),
        "work_decay": max(0.0, _env_float("WORK_DECAY_PER_TICK", 1.0)),
        "release_decay": max(0.0, _env_float("RELEASE_DECAY_PER_TICK", 3.0)),
        "voice_active_min": max(0.0, _env_float("VOICE_ACTIVE_MIN", 0.01)),
        "voice_active_ratio": max(0.0, _env_float("VOICE_ACTIVE_RATIO", 0.04)),
        "min_ref": _env_float("MIN_REF", 0.002),
        "dry_run": _env_bool("PWM_DRY_RUN", False),
        "demo": _env_bool("PWM_DEMO", False),
        "kws_debug": _env_bool("VOICE_KWS_DEBUG", False),
        # 仅用于无真人说话时的端到端诊断: N 秒后注入一次门控事件。
        "test_gate_after": _env_float("PWM_TEST_GATE_AFTER", 0.0),
    }



def _tap_reader_simple(fifo, stop_event, env_fast, env_slow, peak_rms,
                       peak_080, noise_db, wind, kws_prob, business,
                       voice_duration, voice_min):
    """轻量音量包络: 只算 RMS, 不做 FFT/谱减, 避免和 KWS 抢 CPU。"""
    import array
    peak_hist = collections.deque()
    envf = 0.0
    envs = 0.0
    voiced_start = None
    voiced_last = 0.0
    while not stop_event.is_set() and os.getppid() != 1:
        try:
            with open(fifo, "rb", buffering=0) as f:
                while not stop_event.is_set() and os.getppid() != 1:
                    chunk = f.read(1024)
                    if not chunk:
                        break
                    chunk = chunk[:len(chunk) // 2 * 2]
                    samples = array.array("h", chunk)
                    if not samples:
                        continue
                    rms = math.sqrt(sum(s * s for s in samples) / len(samples)) / 32768.0
                    dt = len(samples) / 16000.0
                    a_fast = 1.0 - math.exp(-dt / 0.020)
                    r_fast = 1.0 - math.exp(-dt / 0.080)
                    if rms > envf:
                        envf += a_fast * (rms - envf)
                    else:
                        envf += r_fast * (rms - envf)
                    a_slow = 1.0 - math.exp(-dt / 0.100)
                    r_slow = 1.0 - math.exp(-dt / 0.500)
                    if rms > envs:
                        envs += a_slow * (rms - envs)
                    else:
                        envs += r_slow * (rms - envs)
                    now = time.monotonic()
                    if rms >= voice_min:
                        if voiced_start is None:
                            voiced_start = now
                        voiced_last = now
                        voice_duration.value = now - voiced_start
                    elif (voiced_start is not None
                          and now - voiced_last > 0.60):
                        # 留 0.6s 余量给 KWS 回调/端点判断，避免刚好在
                        # 尾音结束后把拖音前导清零。
                        voiced_start = None
                        voice_duration.value = 0.0
                    peak_hist.append((now, rms))
                    while peak_hist and now - peak_hist[0][0] > 1.5:
                        peak_hist.popleft()
                    peak = max((v for _, v in peak_hist), default=0.0)
                    p080 = max((v for t, v in peak_hist
                                if now - t <= 0.8), default=0.0)
                    env_fast.value = envf
                    env_slow.value = envs
                    peak_rms.value = peak
                    peak_080.value = p080
                    noise_db.value = -60.0
                    wind.value = 0.0
        except FileNotFoundError:
            time.sleep(0.2)
        except Exception as exc:
            os.write(2, f"[dsp-simple] {exc}\n".encode())
            time.sleep(0.2)
    os._exit(0)


def _judgment_worker(event_conn, stop_event, gate_seq, cfg) -> None:
    """判断进程: 整词优先，单字序列兜底。

    真正的门控需求只有两种说法:
      - 正常“长春”: 整词 chang2 chun1，或单字 chang + chun;
      - 拉长“长～～春”: chang 之后任意长的拖音, 再收到 chun。

    判断规则:
      - 整词 phrase 概率 >= phrase 门限: 直接开门（解决连续说两字时单字 KWS
        只上报其中一个的问题）；
      - 否则记录最近一个 chang，收到 chun 时在可选超时内用两字置信度
        的 max 作为拼装分，达到门限开门；
      - 如果只有 chun、没有 chang/整词，则检查 chun 之前的连续人声时长；
        达到 VOICE_LONG_PREFIX_SECONDS 时视为拖长的“长”，
        chun 置信度只需达到 VOICE_LONG_PREFIX_MIN_CONF（默认 0.10）
        即可开门；短促单独“春”不会达到该时长；
      - 单独 chang/chun/ang、顺序反了、超时或分数不够都保持关灯。
      - VOICE_SEQ_WINDOW=0 表示完全不超时，适合拖得非常长的说法。

    这里必须是独立进程而不是同进程线程: 实测 nn.Speech.run() 在推理期间
    持有 GIL, 同进程线程无法及时消费识别事件。独立进程可以直接使用第二个
    核, 事件通过 Pipe 送出, 不经过 mp.Queue 的 feeder 线程。
    """
    window = cfg["seq_window"]
    window_text = "不限" if window <= 0 else f"{window:.1f}s"
    log.info("判断进程启动: 门限=%.2f window=%s cooldown=%.2fs",
             cfg["gate_threshold"], window_text, cfg["gate_cooldown"])

    last_chang = None
    last_gate = -1.0e9
    try:
        while not stop_event.is_set():
            try:
                if not event_conn.poll(0.2):
                    # 只在配置了超时时清理; 0 表示一直保留最后那个 chang。
                    if (last_chang is not None and window > 0
                            and time.monotonic() - last_chang.mono > window):
                        last_chang = None
                    continue
                event = event_conn.recv()
            except (EOFError, OSError):
                break
            except KeyboardInterrupt:
                break
            except Exception as exc:  # noqa: BLE001
                log.exception("判断进程读取事件失败: %s", exc)
                break

            # 整词 KWS: 正常连读“长春”时单字可能只命中一个，整词仍能直接
            # 给出 chang2 chun1 的高概率；达到门限就直接开门。
            if event.family == "phrase":
                now = time.monotonic()
                if event.conf >= cfg["phrase_threshold"]:
                    if now - last_gate >= cfg["gate_cooldown"]:
                        gate_seq.value = gate_seq.value + 1
                        last_gate = now
                        log.info("SEQ GATE branch=changchun-phrase score=%.3f "
                                 "gate=%.2f keyword=%s",
                                 event.conf, cfg["phrase_threshold"], event.keyword)
                        log.info("GATE[changchun-phrase]: changchun=%.3f",
                                 event.conf)
                    else:
                        log.info("SEQ HOLD phrase=%s p=%.3f "
                                 "reason=cooldown(%.2fs)",
                                 event.keyword, event.conf,
                                 now - last_gate)
                    # 整词已经是一句完整命令，清掉可能残留的单字状态。
                    last_chang = None
                else:
                    log.info("SEQ HOLD phrase=%s p=%.3f < gate=%.2f",
                             event.keyword, event.conf,
                             cfg["phrase_threshold"])
                continue

            if event.family == "chang":
                last_chang = event
                continue

            # ang 仍由 KWS 输出到 CHAR 日志, 但门控不再依赖它。
            if event.family != "chun":
                continue

            if last_chang is None:
                pre = float(getattr(event, "pre_voiced", 0.0))
                # 拖长“长～～春”时 KWS 往往只报 chun，甚至整词也失配。
                # 如果本次连续人声在 chun 之前已经持续了足够久，把它当作
                # 拖长的“长”前导；单独短促的“春”达不到这个时长。
                if (pre >= cfg["long_prefix_seconds"]
                        and event.conf >= cfg["long_prefix_min_conf"]):
                    now = time.monotonic()
                    if now - last_gate >= cfg["gate_cooldown"]:
                        gate_seq.value = gate_seq.value + 1
                        last_gate = now
                        log.info("SEQ GATE branch=changchun-long score=%.3f "
                                 "gate=%.2f pre=%.2fs keyword=%s",
                                 event.conf, cfg["long_prefix_min_conf"], pre,
                                 event.keyword)
                        log.info("GATE[changchun-long]: changchun=%.3f",
                                 event.conf)
                    else:
                        log.info("SEQ HOLD chun=%s p=%.3f pre=%.2fs "
                                 "reason=cooldown(%.2fs)",
                                 event.keyword, event.conf, pre,
                                 now - last_gate)
                else:
                    log.info("SEQ HOLD chun=%s p=%.3f reason=no-chang pre=%.2fs",
                             event.keyword, event.conf, pre)
                continue

            gap = event.mono - last_chang.mono
            if gap < 0:
                log.info("SEQ HOLD chun=%s p=%.3f reason=order",
                         event.keyword, event.conf)
                continue
            if window > 0 and gap > window:
                log.info("SEQ HOLD chun=%s p=%.3f reason=timeout gap=%.2fs",
                         event.keyword, event.conf, gap)
                last_chang = None
                continue

            # 长拖音时 KWS 往往只有其中一个字概率高; 用 max 比平均更稳,
            # 同时仍要求 chang 和 chun 两个字都真的出现过。
            score = max(last_chang.conf, event.conf)
            detail = (f"{last_chang.keyword}={last_chang.conf:.3f}@+0.000s "
                      f"{event.keyword}={event.conf:.3f}@+{gap:.3f}s")
            now = time.monotonic()
            if score >= cfg["gate_threshold"]:
                if now - last_gate >= cfg["gate_cooldown"]:
                    gate_seq.value = gate_seq.value + 1
                    last_gate = now
                    log.info("SEQ GATE branch=changchun score=%.3f (max) "
                             "gate=%.2f gap=%.2fs %s",
                             score, cfg["gate_threshold"], gap, detail)
                    # 保持旧日志兼容格式, 供宿主机记录器抓取。
                    log.info("GATE[%s+%s]: %s=%.3f, %s=%.3f",
                             last_chang.keyword, event.keyword,
                             last_chang.keyword, last_chang.conf,
                             event.keyword, event.conf)
                else:
                    log.info("SEQ HOLD score=%.3f reason=cooldown(%.2fs) %s",
                             score, now - last_gate, detail)
            else:
                log.info("SEQ HOLD score=%.3f < gate=%.2f %s",
                         score, cfg["gate_threshold"], detail)

            # 一句完整的话只消费一次; 避免同一个 chun 反复触发。
            last_chang = None
    finally:
        try:
            event_conn.close()
        except OSError:
            pass
        log.info("判断进程退出")

def main() -> int:
    logging.basicConfig(
        level=os.environ.get("SURPLIFE_LOG", "INFO").upper(),
        format="%(asctime)s %(levelname)s %(name)s: %(message)s",
    )
    raise_voice_priority()
    cfg = build_config()
    log.info("config: model=%s alsa=%s pwm=%d Hz update=%d Hz mode=%s dry=%s demo=%s",
             cfg["model"], cfg["alsa_device"], 1_000_000_000 // cfg["period_ns"],
             cfg["update_hz"], cfg["pwm7_mode"], cfg["dry_run"], cfg["demo"])
    bezier_s = cfg["business_bezier_seconds"]
    jump_note = (f", jump {cfg['business_max']:.0f}%"
                 if cfg["business_intro_target"] < cfg["business_max"] else "")
    log.info("ramp: start->%.0f%% %.2fs bezier%s; "
             "hold 100%% until env < %.0f%% peak for %.2fs; "
             "then 100%% -> 50%% %.2fs / 50%% -> %.0f%% %.2fs "
             "cubic-bezier + %.0f%% -> %.0f%% %.1fs linear; "
             "standby_max=%.0f%%",
             cfg["business_intro_target"], cfg["business_intro_seconds"],
             jump_note,
             cfg["business_hold_ratio"] * 100,
             cfg["business_hold_release_seconds"],
             bezier_s * BUSINESS_BEZIER_SPLIT,
             cfg["light_threshold"],
             bezier_s * (1.0 - BUSINESS_BEZIER_SPLIT),
             cfg["light_threshold"], cfg["standby_max"],
             cfg["business_linear_seconds"], cfg["standby_max"])
    log.info("un shadow only: cand=%s, ek=0.8s max pre-gate, "
             "ed=top30%% post-gate; no KWS #2, no score gate; "
             "hold 100%% only while env >= %.0f%% peak",
             UN_EXPERIMENT_CANDIDATE,
             cfg["business_hold_ratio"] * 100)

    ctx = mp.get_context("fork")
    stop_event = ctx.Event()
    gate_seq = ctx.Value("i", 0, lock=False)

    # 1) 先 fork 音量 DSP, 此时还没有导入 maix, 避免把多媒体状态带进子进程。
    tap = MicTap(cfg["fifo"], stop_event, cfg["long_prefix_rms"])

    # 2) 再 fork PWM 子进程; 它只写 sysfs, 等父进程设置好 A18/A19 复用后再启动。
    #    这样它不会继承 maix/多媒体状态, 在 128 MB 内存的板子上更省。
    pwm_ready = ctx.Event()
    pwm_proc = ctx.Process(
        target=_pwm_worker,
        args=(stop_event, pwm_ready, gate_seq, tap.env_fast, tap.env_slow,
              tap.peak_rms, tap.peak_080, tap.business, cfg),
        daemon=True,
    )
    pwm_proc.start()

    # 3) 判断进程也必须在导入 maix 之前 fork。识别段从 KWS 回调通过 Pipe
    #    直接发送单字事件, 不依赖 mp.Queue 的 feeder 线程, 避免被 GIL 拖住。
    event_recv, event_send = ctx.Pipe(duplex=False)
    judgment_proc = ctx.Process(
        target=_judgment_worker,
        args=(event_recv, stop_event, gate_seq, cfg),
        daemon=True,
    )
    judgment_proc.start()
    event_recv.close()

    try:
        # start/stop 脚本用 SIGTERM 停止服务; 只设置停止事件, 不在这里抛异常
        # (KWS 回调里抛 KeyboardInterrupt 会绕过主循环的 finally)。
        # speech.run() 很快返回, 主循环随后看到 stop_event 并正常清理子进程。
        def _on_term(signum, frame):
            stop_event.set()

        signal.signal(signal.SIGTERM, _on_term)

        # 4) 父进程导入 maix, 设置 A18/A19 的 PWM 复用功能。
        from maix import app, err, nn, pinmap

        if _env_bool("SKIP_PINMAP", False):
            log.info("pinmap skipped by SKIP_PINMAP")
        else:
            for pin, func in (("A18", "PWM6"), ("A19", "PWM7")):
                ret = pinmap.set_pin_function(pin, func)
                if ret != err.Err.ERR_NONE:
                    log.warning("pinmap %s -> %s failed: %s", pin, func, ret)
                else:
                    log.info("pinmap %s -> %s ok", pin, func)
        pwm_ready.set()

        speech = nn.Speech(cfg["model"])
        if cfg["input_wav"]:
            log.info("离线 WAV 调试输入: %s", cfg["input_wav"])
            ret = speech.init(nn.SpeechDevice.DEVICE_WAV, cfg["input_wav"])
        else:
            ret = speech.init(nn.SpeechDevice.DEVICE_MIC,
                              cfg["alsa_device"])
        if ret != err.Err.ERR_NONE:
            log.error("打开音频输入失败 (%s / %s): %s",
                      cfg["alsa_device"], cfg["input_wav"] or "mic", ret)
            return 1

        last_emit = {family: -1.0e9 for family in KWS_FAMILY_ORDER}
        last_char_mono = None
        last_debug_log = 0.0
        send_errors = 0

        def callback(data, length):
            nonlocal last_char_mono, last_debug_log, send_errors
            if length < 1:
                return
            now = time.monotonic()
            best = {}
            top_prob = 0.0
            top_keyword = "-"
            for idx, keyword in enumerate(cfg["kws_keywords"]):
                if idx >= length:
                    break
                try:
                    prob = float(data[idx])
                except (TypeError, ValueError):
                    continue
                if prob > top_prob:
                    top_prob = prob
                    top_keyword = keyword
                family = KWS_FAMILY_OF.get(keyword)
                if family is None:
                    continue
                current = best.get(family)
                if current is None or prob > current[0]:
                    best[family] = (prob, keyword)

            tap.kws_prob.value = top_prob
            if (cfg["kws_debug"] and top_prob >= 0.02
                    and now - last_debug_log >= 0.5):
                last_debug_log = now
                log.info("KWS top=%s p=%.3f", top_keyword, top_prob)

            for family in KWS_FAMILY_ORDER:
                item = best.get(family)
                if item is None:
                    continue
                prob, keyword = item
                if prob < cfg["char_threshold"]:
                    continue
                debounce = (cfg["phrase_debounce"] if family == "phrase"
                            else cfg["char_debounce"])
                if now - last_emit[family] < debounce:
                    continue
                last_emit[family] = now
                dt = 0.0 if last_char_mono is None else now - last_char_mono
                last_char_mono = now
                wall = time.strftime("%H:%M:%S")
                pre_voiced = float(tap.voice_duration.value)
                if family == "phrase":
                    log.info("PHRASE %-12s p=%.3f t=%s mono=%.3f dt=%+.3f "
                             "pre=%.2fs",
                             keyword, prob, wall, now, dt, pre_voiced)
                else:
                    log.info("CHAR %-6s p=%.3f t=%s mono=%.3f dt=%+.3f "
                             "pre=%.2fs",
                             keyword, prob, wall, now, dt, pre_voiced)
                event = CharEvent(now, wall, keyword, family, prob, pre_voiced)
                try:
                    event_send.send(event)
                except (BrokenPipeError, EOFError, OSError) as exc:
                    send_errors += 1
                    if send_errors <= 3:
                        log.error("关键词事件发送到判断进程失败: %s", exc)
                    return

        speech.kws(list(cfg["kws_keywords"]),
                   [0.1] * len(cfg["kws_keywords"]), callback, True)
        log.info("识别单字: %s (单字门限 %.2f, 去抖 %.2fs)",
                 " ".join(cfg["char_keywords"]),
                 cfg["char_threshold"], cfg["char_debounce"])
        log.info("识别整词: %s (整词门限 %.2f, 去抖 %.2fs)",
                 " | ".join(cfg["phrase_keywords"]),
                 cfg["phrase_threshold"], cfg["phrase_debounce"])
        log.info("模型词表不支持: %s; 使用 chun3 覆盖第三声，第四声缺失",
                 "/".join(UNSUPPORTED_CHAR_KEYWORDS))
        window_text = ("不限" if cfg["seq_window"] <= 0
                       else f"{cfg['seq_window']:.1f}s")
        log.info("时序判断: chang -> chun (window=%s, 分数=max(两字置信度)); "
                 "门限=%.2f, cooldown=%.2fs, 长前导=%.2fs@rms>=%.3f "
                 "低置信门限=%.2f",
                 window_text, cfg["gate_threshold"], cfg["gate_cooldown"],
                 cfg["long_prefix_seconds"], cfg["long_prefix_rms"],
                 cfg["long_prefix_min_conf"])

        loop_start = time.monotonic()
        test_gate_sent = False
        while not app.need_exit() and not stop_event.is_set():
            if not pwm_proc.is_alive():
                log.error("PWM 子进程退出")
                break
            if not tap.proc.is_alive():
                log.error("音量 DSP 子进程退出")
                break
            if not judgment_proc.is_alive():
                log.error("判断进程退出")
                break
            if (cfg["test_gate_after"] > 0 and not test_gate_sent
                    and time.monotonic() - loop_start >= cfg["test_gate_after"]):
                gate_seq.value = gate_seq.value + 1
                test_gate_sent = True
                log.info("TEST GATE: 已注入一次门控事件")
            if speech.run(1) < 1:
                log.warning("音频输入结束")
                break
    except KeyboardInterrupt:
        log.info("收到 Ctrl+C")
    finally:
        stop_event.set()
        try:
            event_send.close()
        except OSError:
            pass
        if judgment_proc.is_alive():
            judgment_proc.join(2.0)
            if judgment_proc.is_alive():
                judgment_proc.terminate()
                judgment_proc.join(1.0)
        if pwm_proc.is_alive():
            pwm_proc.join(2.0)
            if pwm_proc.is_alive():
                pwm_proc.terminate()
                pwm_proc.join(1.0)
        _pwm_off(cfg["pwm6_path"])
        _pwm_off(cfg["pwm7_path"])
        tap.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
